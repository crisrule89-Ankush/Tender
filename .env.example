PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret

DB_SERVER=localhost
DB_PORT=1433
DB_NAME=TenderManagement
DB_USER=sa
DB_PASSWORD=replace-with-your-sql-server-password
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# These are column names in the existing dbo.userlogin table.
LOGIN_USERNAME_COLUMN=User_Name
LOGIN_PASSWORD_COLUMN=User_Password
LOGIN_BRANCH_COLUMN=Branch_Name
LOGIN_ROLE_COLUMN=Role
# The supplied dbo.userlogin table contains legacy plain-text passwords.
# Migrate these to bcrypt/scrypt hashes for any production deployment.
AUTH_PASSWORD_FORMAT=plain

# Usually run the included create-if-missing schema on startup.
AUTO_CREATE_SCHEMA=true
